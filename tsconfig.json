{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist/",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmitOnError": true
  },
  "include": [
    "main.ts",
    "agent/**/*.ts",
    "tools/registry.ts",
    "tools/executor.ts",
    "intelligence/**/*.ts",
    "config/**/*.ts",
    "deepseek-client.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
